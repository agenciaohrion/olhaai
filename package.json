{
  "name": "olhaai-signage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OLHA.AI — Sistema de gestão de Marketing Indoor (digital signage multi-tenant)",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"node server/index.js\" \"vite --config web/vite.config.js\"",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "simulate": "node scripts/simulate.mjs",
    "test": "node scripts/smoke.mjs",
    "test:ui": "node scripts/uitest.mjs",
    "check": "npm run build && npm test && npm run test:ui"
  },
  "dependencies": {
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
